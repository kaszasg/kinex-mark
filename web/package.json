{
	"name": "kinex-mark-web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^24 || >=26"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p e2e/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"sync:css": "node scripts/sync-app-css.mjs",
		"seed:demo": "node e2e/support/seed-demo.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@testing-library/jest-dom": "^8.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.13",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"bits-ui": "^2.21.0",
		"cn": "^0.5.2",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"dependencies": {
		"@lucide/svelte": "^1.77.0",
		"mode-watcher": "^1.1.0",
		"uqr": "^0.1.2"
	}
}
